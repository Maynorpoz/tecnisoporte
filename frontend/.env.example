# Plantilla de variables del frontend. Copiar a .env y ajustar.
# El .env real no se versiona.
#
# Vite solo expone al navegador las variables que empiezan con VITE_,
# asi que aqui nunca debe ir nada secreto: todo lo que se ponga termina
# dentro del bundle que descarga el usuario.

VITE_API_URL=http://localhost:3100/api
