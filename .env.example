# Plantilla de variables de entorno.
# Copia este archivo a .env y rellena los valores reales.
# El .env real NUNCA se sube al repositorio: está en .gitignore.
# En el pipeline estos valores vienen de un Variable Group de Azure DevOps,
# no de este archivo.

NODE_ENV=development
PORT=3100

# Cadena de conexión a PostgreSQL.
# El contenedor local se levanta con devops/docker-compose.yml
DATABASE_URL=postgresql://incident_user:TU_PASSWORD_LOCAL@localhost:5435/incident_hub

# Password del contenedor local de PostgreSQL
POSTGRES_PASSWORD=TU_PASSWORD_LOCAL

# Origen al que se le permite llamar a la API desde el navegador.
# Si no se define, se usa el del frontend local.
CORS_ORIGIN=http://localhost:5173

# Base de datos que usan las pruebas. Es otra base dentro del mismo
# contenedor de Postgres, para que las pruebas no borren los datos con
# los que se esta trabajando.
TEST_DATABASE_URL=postgresql://incident_user:TU_PASSWORD_LOCAL@localhost:5435/tecnisoporte_test
