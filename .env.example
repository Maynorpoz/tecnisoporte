# Plantilla de variables de entorno.
# Copia este archivo a .env y rellena los valores reales.
# El .env real NUNCA se sube al repositorio: está en .gitignore.
# En el pipeline estos valores vienen de un Variable Group de Azure DevOps,
# no de este archivo.

NODE_ENV=development
PORT=3000

# Cadena de conexión a PostgreSQL.
# El contenedor local se levanta con devops/docker-compose.yml
DATABASE_URL=postgresql://incident_user:TU_PASSWORD_LOCAL@localhost:5432/incident_hub

# Password del contenedor local de PostgreSQL
POSTGRES_PASSWORD=TU_PASSWORD_LOCAL
