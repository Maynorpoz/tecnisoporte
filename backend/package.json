{
  "name": "tecnisoporte-backend",
  "version": "1.0.2",
  "private": true,
  "description": "API REST de TecniSoporte",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand",
    "lint": "eslint ."
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/../tests"
    ],
    "modulePaths": [
      "<rootDir>/node_modules"
    ],
    "testMatch": [
      "<rootDir>/../tests/**/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/../tests/setup/env.js"
    ],
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "<rootDir>/../test-results",
          "outputName": "junit.xml",
          "classNameTemplate": "{classname}",
          "titleTemplate": "{title}"
        }
      ]
    ]
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "eslint": "^9.14.0",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "supertest": "^7.0.0"
  }
}
